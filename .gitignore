node_modules/
out/
# Raw footage and voiceover live in Google Drive, not git.
public/media/*
!public/media/.gitkeep

# Footage is rendered by capture/, not committed.
public/captures/

# Licensed music beds are built locally by scripts/build-music.py, never committed
# (Mixkit Stock Music Free License: free in videos, no redistribution).
public/music/

# Voiceover audio is built locally by scripts/build-voiceover.py, never committed.
public/vo/

# v2 screen recording and site image (the user's own media), kept out of git.
public/v2/*.mp4
public/v2/*.png

# Ad voiceover (user audio), kept out of git.
public/v3/*.mp3
